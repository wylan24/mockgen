{
  "name": "@wylan24/mockgen",
  "version": "0.1.0-alpha.5",
  "description": "Turn an OpenAPI spec into a running mock server with realistic, deterministic fake data — one command.",
  "keywords": [
    "mock",
    "openapi",
    "mock-server",
    "api",
    "faker",
    "testing"
  ],
  "license": "MIT",
  "author": "wylan24",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wylan24/mockgen.git"
  },
  "homepage": "https://github.com/wylan24/mockgen#readme",
  "bugs": "https://github.com/wylan24/mockgen/issues",
  "type": "module",
  "bin": {
    "mockgen": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve:example": "npm run build && node dist/cli.js serve examples/petstore.yaml",
    "prepublishOnly": "npm run build",
    "corpus:fetch": "tsx scripts/corpus-fetch.ts",
    "corpus": "tsx scripts/corpus.ts",
    "corpus:explain": "tsx scripts/corpus-explain.ts",
    "smoke": "npm run build && tsx scripts/smoke-pack.ts"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^16.0.5",
    "@faker-js/faker": "10.6.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "randexp": "0.5.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
